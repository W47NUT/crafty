{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "breezys-creative-co",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "breezys.net",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
}
