<section class="commission-inquiry" aria-labelledby="inquiry-heading">
  <div class="inquiry-intro">
    <p class="section-label">03 / Begin a conversation</p>
    <h2 id="inquiry-heading">Tell Bre what you have in mind.</h2>
    <p>
      This form shows the information that will help begin an inquiry. Online
      submission is not connected yet, so nothing entered here will be sent.
    </p>
  </div>

  <form aria-describedby="form-status">
    <div class="field-pair">
      <div class="form-field">
        <label for="commission-name">Name</label>
        <input
          id="commission-name"
          name="name"
          type="text"
          autocomplete="name"
        />
      </div>

      <div class="form-field">
        <label for="commission-email">Email</label>
        <input
          id="commission-email"
          name="email"
          type="email"
          autocomplete="email"
        />
      </div>
    </div>

    <div class="field-pair">
      <div class="form-field">
        <label for="commission-piece">What would you like made?</label>
        <input id="commission-piece" name="piece" type="text" />
      </div>

      <div class="form-field">
        <label for="commission-quantity"
          >Desired quantity <span>(optional)</span></label
        >
        <input
          id="commission-quantity"
          name="quantity"
          type="text"
          inputmode="numeric"
        />
      </div>
    </div>

    <div class="form-field">
      <label for="commission-idea">Tell Bre about your idea</label>
      <textarea id="commission-idea" name="idea" rows="7"></textarea>
    </div>

    <div class="form-action">
      <button type="button" disabled>Online submission coming soon</button>
      <p id="form-status">
        This inquiry form is a preview and is not currently connected.
      </p>
    </div>
  </form>
</section>

