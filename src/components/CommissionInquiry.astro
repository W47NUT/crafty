<section class="commission-inquiry" aria-labelledby="inquiry-heading">
  <div class="inquiry-intro">
    <p class="section-label">03 / Begin a conversation</p>
    <h2 id="inquiry-heading">Tell Bre what you have in mind.</h2>
    <p>
      Share the details that will help Bre understand your custom-work idea.
    </p>
  </div>

  <form id="commission-form" aria-describedby="commission-form-status">
    <div class="field-pair">
      <div class="form-field">
        <label for="commission-name">Name</label>
        <input
          id="commission-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="100"
          required
        />
      </div>

      <div class="form-field">
        <label for="commission-email">Email</label>
        <input
          id="commission-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
        />
      </div>
    </div>

    <div class="field-pair">
      <div class="form-field">
        <label for="commission-piece">What would you like made?</label>
        <input
          id="commission-piece"
          name="requestedPiece"
          type="text"
          maxlength="200"
          required
        />
      </div>

      <div class="form-field">
        <label for="commission-quantity"
          >Desired quantity <span>(optional)</span></label
        >
        <input
          id="commission-quantity"
          name="quantity"
          type="text"
          inputmode="numeric"
          maxlength="50"
        />
      </div>
    </div>

    <div class="form-field">
      <label for="commission-idea">Tell Bre about your idea</label>
      <textarea
        id="commission-idea"
        name="idea"
        rows="7"
        maxlength="5000"
        required></textarea>
    </div>

    <div class="honeypot" aria-hidden="true">
      <label for="commission-website">Website</label>
      <input
        id="commission-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="form-action">
      <button type="submit">Send commission inquiry</button>
      <p id="commission-form-status" role="status" aria-live="polite"></p>
    </div>
  </form>
</section>

<style>
  .commission-inquiry {
    display: grid;
    grid-template-columns: minmax(18rem, 0.7fr) minmax(0, 1.3fr);
    padding: clamp(5rem, 9vw, 10rem)
      max(1.5rem, calc((100% - var(--page-width)) / 2));
    background: var(--color-blush-soft);
    gap: clamp(3rem, 9vw, 10rem);
  }

  .inquiry-intro {
    max-width: 39rem;
  }

  .section-label {
    margin: 0 0 2rem;
    color: var(--color-charcoal);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5.75rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .inquiry-intro > p:last-child {
    margin: 2rem 0 0;
    color: var(--color-charcoal);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  form {
    padding: clamp(1.5rem, 4vw, 4rem);
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    box-shadow: 0 1.5rem 3rem rgb(55 45 34 / 6%);
  }

  .field-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .form-field + .field-pair,
  .field-pair + .field-pair,
  .field-pair + .form-field {
    margin-top: 2rem;
  }

  .form-field {
    min-width: 0;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  label {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--color-charcoal);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  label span {
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  input,
  textarea {
    display: block;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-ink);
    background: var(--color-paper);
    font: inherit;
  }

  input {
    min-height: 3.25rem;
    padding: 0.65rem 0.85rem;
  }

  textarea {
    min-height: 10rem;
    padding: 0.85rem;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-ink);
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .form-action {
    display: flex;
    align-items: center;
    margin-top: 2.25rem;
    gap: 1.25rem;
  }

  button {
    min-height: 3.5rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--color-charcoal);
    color: var(--color-charcoal);
    background: transparent;
    font: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .form-action p {
    max-width: 21rem;
    margin: 0;
    color: var(--color-charcoal);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .form-action p[data-state="success"] {
    color: #3f5d3b;
  }

  .form-action p[data-state="error"] {
    color: #8a3f34;
  }

  @media (max-width: 62rem) {
    .commission-inquiry {
      grid-template-columns: 1fr;
    }

    .inquiry-intro {
      max-width: 48rem;
    }
  }

  @media (max-width: 42rem) {
    .commission-inquiry {
      padding-inline: 1rem;
    }

    .field-pair {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .form-action {
      align-items: stretch;
      flex-direction: column;
    }

    button {
      width: 100%;
    }
  }
</style>

<script>
  import { setupFormSubmission } from "../scripts/submitForm";

  const form = document.querySelector<HTMLFormElement>("#commission-form");
  if (form) {
    setupFormSubmission({
      endpoint: "/api/commission",
      form,
      sendingLabel: "Sending…",
    });
  }
</script>
