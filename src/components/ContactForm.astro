<section
  class="contact-form-section"
  id="general-contact"
  aria-labelledby="general-contact-heading"
>
  <div class="form-intro">
    <p class="section-label">02 / General contact</p>
    <h2 id="general-contact-heading">Leave a note for the studio.</h2>
    <p>
      This form shows what a future general message will include. Online
      submission is not connected yet, so nothing entered here will be sent.
    </p>
  </div>

  <form aria-describedby="contact-form-status">
    <div class="field-pair">
      <div class="form-field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="contact-email">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
        />
      </div>
    </div>

    <div class="form-field">
      <label for="contact-subject">Subject</label>
      <input id="contact-subject" name="subject" type="text" />
    </div>

    <div class="form-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="8"></textarea>
    </div>

    <div class="form-action">
      <button type="button" disabled>Online submission coming soon</button>
      <p id="contact-form-status">
        This contact form is a preview and is not currently connected. Nothing
        entered will be sent.
      </p>
    </div>
  </form>
</section>

