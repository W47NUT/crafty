---
import {
  SHOP_PRODUCT_TYPE_LABELS,
  type ShopProduct,
} from "../data/shop-catalog";

interface Props {
  product: ShopProduct;
}

const { product } = Astro.props;
const image = product.images[0];
const isSold = product.availability === "sold";
---

<article class:list={["product-card", { "product-card-sold": isSold }]}>
  <div class="product-image">
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="lazy"
    />
  </div>

  <div class="product-meta">
    <span>{SHOP_PRODUCT_TYPE_LABELS[product.productType]}</span>
    {isSold && <span>Sold</span>}
  </div>

  <h3>{product.name}</h3>
  <p class="product-description">{product.description}</p>
  <p class="product-price">{product.priceLabel}</p>
</article>

<style>
  .product-card {
    min-width: 0;
  }

  .product-image {
    padding: clamp(0.45rem, 0.8vw, 0.8rem);
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    box-shadow: 0 1.5rem 3rem rgb(55 45 34 / 6%);
  }

  .product-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .product-card-sold .product-image img {
    filter: saturate(0.55);
    opacity: 0.72;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-charcoal);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h3 {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .product-description {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: var(--color-charcoal);
    line-height: 1.7;
  }

  .product-price {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
