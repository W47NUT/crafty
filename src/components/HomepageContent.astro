---
const makingCategories = [
  {
    number: "01",
    name: "Shirts",
    description:
      "Heat-transfer-vinyl T-shirts, including custom work handled through commission inquiries.",
    accent: "blush",
  },
  {
    number: "02",
    name: "Paintings",
    description:
      "Original paintings for the portfolio, with custom paintings welcomed through commission inquiries.",
    accent: "sage",
  },
  {
    number: "03",
    name: "Resin Pieces",
    description:
      "Molded epoxy-resin work, including D&D dice and beach-sand and shell coasters.",
    accent: "gold",
  },
  {
    number: "04",
    name: "Accessories",
    description: "Bead bracelets made as part of Bre's range of handmade work.",
    accent: "taupe",
  },
];
---

<section class="makes-section" aria-labelledby="makes-heading">
  <div class="section-introduction">
    <p class="section-eyebrow">Made by Bre</p>
    <h2 id="makes-heading">What Bre Makes</h2>
    <p>
      Breezy's Creative Co. brings wearable, painted, resin, and beaded work
      together in one creative practice.
    </p>
  </div>

  <div class="category-list">
    {
      makingCategories.map((category) => (
        <article class={`category-card category-card-${category.accent}`}>
          <span class="category-number" aria-hidden="true">
            {category.number}
          </span>
          <h3>{category.name}</h3>
          <p>{category.description}</p>
        </article>
      ))
    }
  </div>
</section>

<section
  class="portfolio-section"
  id="selected-work"
  aria-labelledby="portfolio-heading"
>
  <img
    class="portfolio-ornament"
    src="/images/brand/breezys-botanical-edge.png"
    alt=""
    width="524"
    height="719"
    loading="lazy"
  />
  <div class="portfolio-heading">
    <div>
      <p class="section-eyebrow">Selected work</p>
      <h2 id="portfolio-heading">A place for the work to speak.</h2>
    </div>
    <div class="portfolio-introduction">
      <p>
        A curated look at finished work across Bre's creative practice.
        Portfolio pieces do not need to be currently for sale.
      </p>
      <a class="text-link" href="#selected-work">View Portfolio</a>
    </div>
  </div>

  <div
    class="portfolio-grid"
    role="group"
    aria-label="Selected work photography"
  >
    <div class="portfolio-item portfolio-item-featured">
      <img
        src="/images/work/sugar-spice-tote.webp"
        alt='Custom tote bag with "Sugar Spice & Everything Nice" design'
        width="2235"
        height="2023"
        loading="lazy"
      />
    </div>
    <div class="portfolio-item portfolio-item-tall">
      <img
        src="/images/work/psalm-shirt.webp"
        alt="White shirt with Psalm 46:5 floral cross design"
        width="3000"
        height="2259"
        loading="lazy"
      />
    </div>
    <div class="portfolio-item portfolio-item-wide">
      <img
        src="/images/work/beauty-pouch.webp"
        alt='Cosmetic pouch with "When you think of beautiful things..." design'
        width="3000"
        height="2259"
        loading="lazy"
      />
    </div>
  </div>
</section>

<section
  class="commission-section"
  id="commissions"
  aria-labelledby="commission-heading"
>
  <img
    class="commission-medallion"
    src="/images/brand/breezys-commission-medallion.png"
    alt=""
    width="1000"
    height="1000"
    loading="lazy"
  />
  <div class="commission-copy">
    <p class="section-eyebrow">Made for you</p>
    <h2 id="commission-heading">Bring an idea to the studio.</h2>
    <p>
      Custom work is welcome. Custom shirts and paintings are core examples of
      work that can begin with a commission inquiry and a conversation about
      what you have in mind.
    </p>
    <a class="button-link" href="#commissions">Request a Commission</a>
  </div>
</section>

<section class="about-section" id="about" aria-labelledby="about-heading">
  <div class="about-image">
    <div class="image-placeholder">
      <span>Portrait or studio photo</span>
    </div>
  </div>
  <img
    class="about-bird"
    src="/images/brand/breezys-bird-accent.png"
    alt=""
    width="274"
    height="343"
    loading="lazy"
  />
  <div class="about-copy">
    <p class="section-eyebrow">Behind the work</p>
    <h2 id="about-heading">Meet Bre</h2>
    <p>
      Bre is the primary artist and maker behind Breezy's Creative Co., a
      home-based creative business built around original art, custom work, and
      handmade pieces.
    </p>
    <p>
      Current work spans shirts, paintings, molded resin pieces, D&D dice,
      beach-sand and shell coasters, and bead bracelets.
    </p>
    <a class="text-link" href="#about">Read Bre's Story</a>
  </div>
</section>

<style>
  .makes-section,
  .portfolio-section,
  .about-section {
    width: min(100% - 3rem, var(--page-width));
    margin-inline: auto;
  }

  .makes-section {
    display: grid;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    padding-block: clamp(5rem, 9vw, 9rem);
    gap: clamp(3rem, 7vw, 8rem);
  }

  .section-introduction {
    max-width: 31rem;
  }

  .section-eyebrow {
    margin: 0 0 1rem;
    color: var(--color-charcoal);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 4.5vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .section-introduction > p:last-child,
  .portfolio-introduction p,
  .commission-copy > p,
  .about-copy > p {
    color: var(--color-charcoal);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .section-introduction > p:last-child {
    margin: 1.75rem 0 0;
  }

  .category-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
  }

  .category-card {
    position: relative;
    min-height: 15rem;
    padding: 2rem clamp(1.5rem, 3vw, 2.75rem);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .category-card:nth-child(even) {
    border-right: 0;
  }

  .category-card::after {
    position: absolute;
    right: -2.5rem;
    bottom: -3.5rem;
    width: 8rem;
    height: 8rem;
    border: 1px solid var(--category-accent);
    border-radius: 50%;
    content: "";
    opacity: 0.6;
  }

  .category-card-blush {
    --category-accent: var(--color-blush);
  }

  .category-card-sage {
    --category-accent: var(--color-sage);
  }

  .category-card-gold {
    --category-accent: var(--color-gold);
  }

  .category-card-taupe {
    --category-accent: var(--color-taupe);
  }

  .category-number {
    color: var(--category-accent);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-style: italic;
  }

  .category-card h3 {
    margin: 2.25rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.3vw, 2.5rem);
    font-weight: 400;
  }

  .category-card p {
    max-width: 25rem;
    margin: 0;
    color: var(--color-charcoal);
    line-height: 1.65;
  }

  .portfolio-section {
    position: relative;
    padding-block: clamp(5rem, 9vw, 9rem);
    border-top: 1px solid var(--color-border);
    overflow: clip;
  }

  .portfolio-ornament {
    position: absolute;
    z-index: 0;
    right: -2rem;
    bottom: -3rem;
    width: clamp(7.5rem, 8vw, 9rem);
    height: auto;
    opacity: 0.25;
    pointer-events: none;
  }

  .portfolio-heading,
  .portfolio-grid {
    position: relative;
    z-index: 1;
  }

  .portfolio-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 8rem);
  }

  .portfolio-heading h2 {
    max-width: 50rem;
  }

  .portfolio-introduction p {
    margin: 0 0 1.5rem;
  }

  .text-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-bottom: 1px solid var(--color-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .text-link:hover {
    background: var(--color-cream);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-rows: minmax(12rem, 0.8fr) minmax(15rem, 1.2fr);
    height: clamp(34rem, 53vw, 51rem);
    margin-top: clamp(3rem, 6vw, 6rem);
    gap: clamp(1rem, 2vw, 2rem);
  }

  .portfolio-item {
    padding: clamp(0.55rem, 1vw, 0.85rem);
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    box-shadow: 0 1rem 2rem rgb(55 45 34 / 7%);
  }

  .portfolio-item-featured {
    grid-row: 1 / 3;
    transform: rotate(-0.45deg);
  }

  .portfolio-item-tall {
    width: 76%;
    margin-left: 8%;
    transform: rotate(0.7deg);
  }

  .portfolio-item-wide {
    transform: rotate(-0.3deg);
  }

  .portfolio-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portfolio-item-featured img {
    object-position: center;
  }

  .portfolio-item-tall img {
    object-position: 58% center;
  }

  .portfolio-item-wide img {
    object-position: center 62%;
  }

  .image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 12rem;
    place-items: center;
    color: var(--color-charcoal);
    background:
      linear-gradient(
        145deg,
        transparent 49%,
        rgb(91 78 63 / 7%) 49% 50%,
        transparent 50%
      ),
      linear-gradient(35deg, var(--color-border), var(--color-cream));
  }

  .image-placeholder span {
    padding: 0.45rem;
    border-bottom: 1px solid var(--color-taupe);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-style: italic;
    letter-spacing: 0.05em;
  }

  .commission-section {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    padding: clamp(5rem, 9vw, 9rem)
      max(1.5rem, calc((100% - var(--page-width)) / 2));
    background: var(--color-blush-soft);
    gap: clamp(3rem, 9vw, 10rem);
  }

  .commission-medallion {
    width: min(100%, 29rem);
    height: auto;
    justify-self: center;
  }

  .commission-copy {
    max-width: 47rem;
  }

  .commission-copy > p {
    max-width: 42rem;
    margin: 2rem 0 0;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    margin-top: 2.25rem;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--color-ink);
    color: var(--color-cream);
    background: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .button-link:hover {
    color: var(--color-ink);
    background: transparent;
  }

  .about-section {
    position: relative;
    display: grid;
    grid-template-columns: minmax(20rem, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    padding-block: clamp(5rem, 10vw, 10rem);
    gap: clamp(3rem, 9vw, 10rem);
  }

  .about-image {
    height: clamp(31rem, 48vw, 46rem);
    padding: clamp(0.65rem, 1vw, 1rem);
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    transform: rotate(-0.7deg);
  }

  .about-copy {
    max-width: 42rem;
  }

  .about-bird {
    position: absolute;
    top: calc(50% - 11rem);
    right: 1rem;
    width: clamp(4.5rem, 5.5vw, 6rem);
    height: auto;
    opacity: 0.48;
    pointer-events: none;
  }

  .about-copy > p {
    margin: 1.75rem 0 0;
  }

  .about-copy .text-link {
    margin-top: 1.5rem;
  }

  @media (max-width: 62rem) {
    .makes-section,
    .portfolio-heading,
    .commission-section,
    .about-section {
      grid-template-columns: 1fr;
    }

    .section-introduction,
    .commission-copy,
    .about-copy {
      max-width: 48rem;
    }

    .commission-medallion {
      width: min(65vw, 24rem);
    }

    .portfolio-ornament,
    .about-bird {
      display: none;
    }

    .about-image {
      width: min(100%, 40rem);
      height: min(100vw, 38rem);
    }
  }

  @media (max-width: 42rem) {
    .makes-section,
    .portfolio-section,
    .about-section {
      width: min(100% - 2rem, var(--page-width));
    }

    .category-list {
      grid-template-columns: 1fr;
    }

    .category-card {
      min-height: auto;
      padding-block: 1.75rem;
      border-right: 0;
    }

    .category-card h3 {
      margin-top: 1.25rem;
    }

    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: clamp(17rem, 72vw, 21rem) clamp(11rem, 46vw, 14rem);
      height: auto;
      gap: 0.75rem;
    }

    .portfolio-item {
      padding: 0.4rem;
    }

    .portfolio-item-featured {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .portfolio-item-tall {
      width: 92%;
      margin-left: 0;
    }

    .portfolio-item-tall img,
    .portfolio-item-wide img {
      object-fit: contain;
      background: var(--color-paper);
    }

    .image-placeholder span {
      max-width: 8rem;
      text-align: center;
    }

    .commission-section {
      padding-inline: 1rem;
    }

    .commission-medallion {
      width: min(75vw, 20rem);
    }

    .button-link {
      width: 100%;
    }

    .about-image {
      height: min(120vw, 32rem);
    }
  }
</style>
